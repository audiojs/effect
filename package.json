{
  "name": "@audio/effect",
  "version": "2.4.0",
  "type": "module",
  "sideEffects": false,
  "description": "Audio effects — umbrella for @audio/effect-* atoms (modulation, delay, distortion, utility)",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node --test test.js test-api.js",
    "plot": "node plot/generate.js",
    "test:all": "npm test --workspaces --if-present && npm test",
    "publish:all": "node ../compile/tools/tested.js && npm publish --workspaces && npm publish",
    "prepublishOnly": "node ../compile/tools/tested.js"
  },
  "files": [
    "index.js",
    "*.d.ts",
    "audio.js"
  ],
  "keywords": [
    "audio",
    "effect",
    "dsp",
    "phaser",
    "flanger",
    "chorus",
    "reverb",
    "compressor",
    "distortion",
    "bitcrusher"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/effect.git"
  },
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bugs": {
    "url": "https://github.com/audiojs/effect/issues"
  },
  "homepage": "https://github.com/audiojs/effect#readme",
  "main": "index.js",
  "dependencies": {
    "@audio/effect-phaser": "^1.2.1",
    "@audio/effect-flanger": "^2.1.1",
    "@audio/effect-chorus": "^2.1.1",
    "@audio/effect-wah": "^1.2.1",
    "@audio/effect-autowah": "^1.1.7",
    "@audio/effect-tremolo": "^1.2.1",
    "@audio/effect-vibrato": "^2.1.1",
    "@audio/effect-ringmod": "^1.1.7",
    "@audio/effect-freqshift": "^1.2.1",
    "@audio/effect-delay": "^1.1.1",
    "@audio/effect-multitap": "^1.1.8",
    "@audio/effect-pingpong": "^1.2.1",
    "@audio/effect-distortion": "^1.1.7",
    "@audio/effect-bitcrusher": "^1.1.7",
    "@audio/effect-exciter": "^1.2.3",
    "@audio/effect-gain": "^1.1.4",
    "@audio/effect-mixer": "^1.0.2",
    "@audio/effect-slew": "^1.1.7",
    "@audio/effect-noiseshaper": "^1.1.7",
    "@audio/effect-graindelay": "^1.2.1",
    "@audio/effect-lofi": "^1.2.1",
    "@audio/effect-sbr": "^1.3.1",
    "@audio/effect-stutter": "^1.2.1",
    "@audio/effect-subbass": "^1.3.1",
    "@audio/effect-rotary": "^0.2.1",
    "@audio/effect-tapestop": "^0.2.1"
  },
  "funding": "https://github.com/sponsors/audiojs",
  "types": "./index.d.ts"
}
